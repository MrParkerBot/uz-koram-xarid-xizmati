# Every environment variable this application reads. config/settings.py loads
# the .env beside manage.py at startup, so a value written there reaches the
# next run without being exported by hand. Copy this file and fill it in:
#   cp .env.example .env    # Windows PowerShell: Copy-Item .env.example .env
#
# A variable already set in the real environment wins over the file, so a
# deployment keeps configuring itself the usual way and a .env that ends up on
# a server by accident cannot override it. A local .env is never committed.
# Placeholder values only - never commit a real secret to this file.

# Required in any real deployment. Without it a key is generated at startup,
# which changes on every restart and invalidates all sessions.
DJANGO_SECRET_KEY=replace-with-a-generated-50-character-key

# Off unless explicitly enabled. Accepts 1, true, yes, on; 0, false, no, off
# turn it off, and anything else is reported on stderr and read as unset.
# Turn it on for local development so runserver serves the static files.
DJANGO_DEBUG=off

# Comma separated. Defaults to localhost,127.0.0.1 when unset. Host names
# only - no scheme and no port.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Marks the session and CSRF cookies https-only. Turn it on for any
# deployment reachable over HTTPS.
DJANGO_SECURE_COOKIES=off

# Required for any deployment behind a proxy that terminates HTTPS, or every
# form POST answers 403 "Origin checking failed" - Django compares the
# browser's https:// Origin against the http:// request the proxy handed it.
# Comma separated, and each one written WITH its scheme, unlike
# DJANGO_ALLOWED_HOSTS above:
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://example.org,https://www.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=

# Makes Django read X-Forwarded-Proto, so it knows a proxied request arrived
# over HTTPS. Turn it on only when the proxy sets that header itself and
# overwrites whatever the client sent; trusting it otherwise lets any client
# claim https and defeat every secure-only cookie.
DJANGO_TRUST_PROXY_SSL_HEADER=off
