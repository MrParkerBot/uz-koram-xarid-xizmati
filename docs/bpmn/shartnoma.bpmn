    <bpmn:task id="raise" name="Shartnoma kiritiladi (kelishilgan)" />
    <bpmn:task id="send" name="Tasdiqlashga yuboriladi" />
    <bpmn:exclusiveGateway id="decide" name="Bo`lim boshlig`i qarori" />
