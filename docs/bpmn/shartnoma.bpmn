    <bpmn:sequenceFlow id="delivered-done" sourceRef="delivered" targetRef="done" name="" />
    <bpmn:sequenceFlow id="rejected-raise" sourceRef="rejected" targetRef="raise" name="" />
  </bpmn:process>
