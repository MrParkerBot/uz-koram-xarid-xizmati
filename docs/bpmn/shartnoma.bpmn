<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions-shartnoma" targetNamespace="http://uz-koram/xarid">
  <bpmn:process id="shartnoma" name="Shartnoma (REQ-SHARTNOMA-002, DEC-010)" isExecutable="false">
