    <bpmn:task id="delivered" name="Tugallangan holat" />
    <bpmn:task id="rejected" name="Mutaxassisga qaytariladi" />
    <bpmn:endEvent id="done" name="Tugadi" />
    <bpmn:sequenceFlow id="start-raise" sourceRef="start" targetRef="raise" name="" />
    <bpmn:sequenceFlow id="raise-send" sourceRef="raise" targetRef="send" name="" />
